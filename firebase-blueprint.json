{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile and device identity",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Unique Firebase Authentication UID matching request.auth.uid"
        },
        "displayName": {
          "type": "string",
          "description": "User's display name"
        },
        "email": {
          "type": "string",
          "description": "User's Google Account email address"
        },
        "photoUrl": {
          "type": "string",
          "description": "Optional Google avatar URL"
        },
        "deviceName": {
          "type": "string",
          "description": "Device hardware model or custom name"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when user profile was created, written via FieldValue.serverTimestamp()"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when profile was last updated, written via FieldValue.serverTimestamp()"
        }
      },
      "required": ["userId", "displayName", "email", "deviceName", "createdAt", "updatedAt"]
    },
    "TransferRecord": {
      "title": "TransferRecord",
      "description": "Cloud-synced receipt and log of a peer-to-peer file transfer",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for this transfer receipt"
        },
        "userId": {
          "type": "string",
          "description": "Owning user's Firebase UID"
        },
        "fileName": {
          "type": "string",
          "description": "Name of the transferred file"
        },
        "fileSize": {
          "type": "integer",
          "description": "Size of the file in bytes"
        },
        "fileType": {
          "type": "string",
          "enum": ["PHOTOS", "VIDEOS", "AUDIO", "APPS", "CONTACTS", "FILES"],
          "description": "Category of the transferred file"
        },
        "direction": {
          "type": "string",
          "enum": ["SEND", "RECEIVE"],
          "description": "Transfer direction relative to this device"
        },
        "peerName": {
          "type": "string",
          "description": "Display name of the remote peer"
        },
        "status": {
          "type": "string",
          "enum": ["COMPLETED", "FAILED", "CANCELLED"],
          "description": "Completion state of the transfer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp, written via FieldValue.serverTimestamp()"
        }
      },
      "required": ["id", "userId", "fileName", "fileSize", "fileType", "direction", "peerName", "status", "createdAt"]
    },
    "UserSettings": {
      "title": "UserSettings",
      "description": "Per-user application preferences",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owning user's Firebase UID"
        },
        "autoAccept": {
          "type": "boolean",
          "description": "Whether to auto-accept transfers from known peers"
        },
        "customDeviceName": {
          "type": "string",
          "description": "Custom broadcast name for this device"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when settings were updated, written via FieldValue.serverTimestamp()"
        }
      },
      "required": ["userId", "autoAccept", "customDeviceName", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Root user profile document"
    },
    "/users/{userId}/transfers/{transferId}": {
      "schema": {
        "$ref": "#/entities/TransferRecord"
      },
      "description": "Subcollection of transfer logs for this user"
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": {
        "$ref": "#/entities/UserSettings"
      },
      "description": "User preferences documents"
    }
  }
}
