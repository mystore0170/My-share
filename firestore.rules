rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.userId == userId &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 1000)) &&
        data.deviceName is string && data.deviceName.size() >= 1 && data.deviceName.size() <= 100 &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidTransferRecord(data, userId, transferId) {
      return data.id == transferId &&
        data.userId == userId &&
        data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 300 &&
        data.fileSize is int && data.fileSize >= 0 &&
        data.fileType in ['PHOTOS', 'VIDEOS', 'AUDIO', 'APPS', 'CONTACTS', 'FILES'] &&
        data.direction in ['SEND', 'RECEIVE'] &&
        data.peerName is string && data.peerName.size() >= 1 && data.peerName.size() <= 100 &&
        data.status in ['COMPLETED', 'FAILED', 'CANCELLED'] &&
        data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidUserSettings(data, userId) {
      return data.userId == userId &&
        data.autoAccept is bool &&
        data.customDeviceName is string && data.customDeviceName.size() >= 1 && data.customDeviceName.size() <= 100 &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // User profile documents
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data, userId);
      allow update: if isOwner(userId) && isValidUserProfile(request.resource.data, userId) && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(userId);

      // Cloud Transfer History & Receipts
      match /transfers/{transferId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidTransferRecord(request.resource.data, userId, transferId);
        allow update: if isOwner(userId) && isValidTransferRecord(request.resource.data, userId, transferId) && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(userId);
      }

      // User Settings & Preferences
      match /settings/{settingId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidUserSettings(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidUserSettings(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }
    }
  }
}
